+#[cfg(test)]
+mod live_permission_recovery_test {
+    use super::*;
+    #[test]
+    fn live_policy_change_preserves_cloudflare_recovery_identity() {
+        let base = WorkspaceProfile::new("fixture-root".into(), Some("fixture".into()));
+        let mut changed = base.clone();
+        changed.runtime.permission_mode = "read-only".into();
+        changed.runtime.approval_mode = "ask".into();
+        changed.runtime.allow_screen_capture = !base.runtime.allow_screen_capture;
+        changed.runtime.allowed_commands = "echo".into();
+        changed.runtime.tool_profile = "advanced".into();
+        assert!(recovery_config_matches(&base, &changed, TunnelServiceKind::Mcp));
+        changed.actions.permission_mode = "read-only".into();
+        changed.actions.allowed_commands = "echo".into();
+        changed.actions.max_patch_bytes = base.actions.max_patch_bytes + 1;
+        assert!(recovery_config_matches(&base, &changed, TunnelServiceKind::Actions));
+        changed.runtime.local_port += 1;
+        assert!(!recovery_config_matches(&base, &changed, TunnelServiceKind::Mcp));
+        changed.actions.oauth_client_id = "different-client".into();
+        assert!(!recovery_config_matches(&base, &changed, TunnelServiceKind::Actions));
+    }
+}
