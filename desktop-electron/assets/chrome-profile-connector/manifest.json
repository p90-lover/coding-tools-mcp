{
  "manifest_version": 3,
  "name": "Coding Tools — current Chrome sign-in",
  "version": "1.1.0",
  "description": "With your approval, connect this Chrome profile's ChatGPT session to Coding Tools and verify sign-in automatically.",
  "key": "",
  "permissions": ["cookies", "scripting", "storage"],
  "host_permissions": ["https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://openai.com/*", "https://*.openai.com/*"],
  "externally_connectable": { "matches": ["http://127.0.0.1/*"] },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Coding Tools Chrome connector", "default_popup": "confirm.html" },
  "incognito": "not_allowed"
}
