{
  "name": "coding-tools-full-harness-desktop",
  "version": "0.7.0-rc.14",
  "private": true,
  "description": "Coding Tools desktop with the pinned full Codex ChatGPT Web harness",
  "author": "Coding Tools MCP Contributors",
  "type": "module",
  "main": "electron/main-with-provider.cjs",
  "scripts": {
    "dev": "bun run build:preload && bun run scripts/dev.cjs",
    "audit": "bun audit",
    "typecheck": "tsc --noEmit",
    "build:preload": "node scripts/build-preload.cjs",
    "build:renderer": "vite build",
    "build": "bun run build:preload && bun run typecheck && bun run build:renderer",
    "build:runtime": "bun run scripts/prepare-runtime.cjs",
    "build:five-stack-runtime": "node scripts/prepare-five-stack-runtime.cjs",
    "build:package-resources": "node scripts/prepare-package-resources.cjs",
    "package": "bun run build && bun run build:runtime && bun run build:five-stack-runtime && bun run build:package-resources && bun run scripts/package.cjs",
    "package:mac": "bun run build && bun run build:runtime && bun run build:five-stack-runtime && bun run build:package-resources && bun run scripts/package.cjs --mac",
    "package:win": "bun run build && bun run build:runtime && bun run build:five-stack-runtime && bun run build:package-resources && bun run scripts/package.cjs --win",
    "package:linux": "bun run build && bun run build:runtime && bun run build:five-stack-runtime && bun run build:package-resources && bun run scripts/package.cjs --linux",
    "smoke:package": "bun run scripts/smoke-package.cjs",
    "test": "node --test tests/*.test.cjs",
    "start": "bun run build:preload && electron ."
  },
  "dependencies": {
    "motion": "^12.42.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "41.10.7",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.2"
  },
  "build": {
    "appId": "dev.codingtools.fullharness",
    "productName": "Coding Tools",
    "artifactName": "Coding.Tools_${version}_${os}_${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "assets/linux-appimage-runner.sh",
      "electron/codex-router-managed.cjs",
      "electron/codex-router-original-ui.cjs",
      "electron/cpa-managed.cjs",
      "vendor/bundled/cpa-plugins/**",
      "electron/cpa-codex-long-run.cjs",
      "electron/atomic-file.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "publish": null,
    "files": [
      "dist/**",
      "build/preload.cjs",
      "electron/**",
      "vendor/upstream/**",
      "vendor/managed-components/**",
      "vendor/bundled/**",
      "assets/icon.png",
      "assets/linux-appimage-runner.sh",
      "package.json",
      {
        "from": "../app-handler",
        "to": "app-handler",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/source/test/**"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "build/package-resources",
        "to": "."
      },
      {
        "from": "../app-handler",
        "to": "app-handler",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/source/test/**"
        ]
      },
      {
        "from": "../app-handler",
        "to": "app-modules",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/source/test/**"
        ]
      },
      {
        "from": "../modules",
        "to": "modules",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/source/test/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "signIgnore": [
        "[/\\\\]Contents[/\\\\]Resources[/\\\\]runtime[/\\\\]runtime[/\\\\]bun$"
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "guid": "3cb2ea96-3319-55b8-95a5-7f180a5f3ed4",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  }
}
