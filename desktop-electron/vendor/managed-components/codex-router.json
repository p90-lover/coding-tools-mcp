{
  "schemaVersion": 1,
  "id": "codex-router",
  "name": "Codex Router",
  "managedBy": "Coding Tools",
  "loopbackOnly": true,
  "repository": "duolahypercho/codex-router",
  "repositoryUrl": "https://github.com/duolahypercho/codex-router.git",
  "version": "0.6.0",
  "commit": "930f547d8d8861a47e18a83216e15e73a73aa97c",
  "strategy": "bundled-source",
  "bundle": { "required": true },
  "platformModes": {
    "win32": "native",
    "linux": "native",
    "darwin": "native"
  },
  "install": {
    "steps": [
      {
        "id": "prepare-codex-router",
        "kind": "command",
        "executable": "{runtime}",
        "arguments": [
          "{adapterRoot}/codex-router-managed.cjs",
          "prepare",
          "{home}",
          "{state}"
        ]
      },
      {
        "id": "assert-router-source",
        "kind": "assert-file",
        "path": "src/foreground-start.mjs"
      },
      {
        "id": "assert-curation-source",
        "kind": "assert-file",
        "path": "src/curate-models.mjs"
      },
      {
        "id": "assert-control-center",
        "kind": "assert-file",
        "path": "apps/control-center/electron/main.mjs"
      },
      {
        "id": "activate",
        "kind": "activate"
      }
    ]
  },
  "launch": {
    "primaryProcessId": "router",
    "processes": [
      {
        "id": "router",
        "mode": "foreground",
        "executable": "{runtime}",
        "arguments": [
          "{adapterRoot}/codex-router-managed.cjs",
          "run",
          "{home}",
          "{state}"
        ]
      }
    ]
  },
  "cli": {
    "win32": {
      "router": "{state}/bin/model-router.cmd",
      "curate": "{state}/bin/curate-models.cmd"
    },
    "linux": {
      "router": "{state}/bin/model-router",
      "curate": "{state}/bin/curate-models"
    },
    "darwin": {
      "router": "{state}/bin/model-router",
      "curate": "{state}/bin/curate-models"
    }
  },
  "health": {
    "endpoint": "http://127.0.0.1:4202/_codex-router/{callerKey}/v1/models",
    "acceptStatus": [
      200
    ]
  }
}
