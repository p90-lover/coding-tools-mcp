{
  "schemaVersion": 1,
  "id": "codex-router",
  "name": "Codex Router",
  "managedBy": "Coding Tools",
  "loopbackOnly": true,
  "repository": "duolahypercho/codex-router",
  "version": "0.6.0",
  "strategy": "release-binary",
  "license": "MIT",
  "platforms": {
    "win32": {
      "x64": {
        "url": "https://github.com/duolahypercho/codex-router/releases/download/v0.6.0/model-router-0.6.0-windows-x64.exe",
        "sha256": "24c0f1b1893acdd340119628bc161f23aa70f32cd294a3446d8e16dbca22c17c",
        "fileName": "model-router.exe"
      }
    },
    "linux": {
      "x64": {
        "url": "https://github.com/duolahypercho/codex-router/releases/download/v0.6.0/model-router-0.6.0-linux-x64.tar.gz",
        "sha256": "f17f4b912faf3d14267b6136b055d008a195121ab59ca97faa94187e09d984ef",
        "fileName": "model-router-0.6.0-linux-x64.tar.gz"
      }
    }
  },
  "install": {
    "steps": [
      { "id": "download-release", "kind": "download" },
      { "id": "verify-sha256", "kind": "verify" },
      { "id": "activate", "kind": "activate" }
    ]
  },
  "launch": {
    "processes": [
      {
        "id": "router-service",
        "mode": "command",
        "executable": "{artifact}",
        "arguments": ["codex", "enable"],
        "detached": true
      }
    ]
  },
  "configure": {
    "runtimeCommand": "router integrate"
  },
  "health": {
    "endpoint": "http://127.0.0.1:4202/_codex-router/{callerKey}/v1/models",
    "acceptStatus": [200]
  }
}
