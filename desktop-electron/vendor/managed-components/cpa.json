{
  "schemaVersion": 1,
  "id": "cpa",
  "name": "CPA / CLIProxyAPI",
  "managedBy": "Coding Tools",
  "loopbackOnly": true,
  "repository": "router-for-me/CLIProxyAPI",
  "repositoryUrl": "https://github.com/router-for-me/CLIProxyAPI",
  "version": "8.0.46",
  "strategy": "release-binary",
  "bundle": { "required": true },
  "license": "MIT",
  "licenseFile": "LICENSE",
  "credentials": {
    "managementKey": {
      "required": false,
      "generated": true,
      "minimumLength": 32,
      "purpose": "Local CLIProxyAPI management API"
    },
    "proxyApiKey": {
      "required": false,
      "generated": true,
      "minimumLength": 32,
      "purpose": "Local OpenAI-compatible proxy API"
    }
  },
  "platforms": {
    "win32": {
      "x64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.46/CLIProxyAPI_8.0.46_windows_amd64.zip",
        "sha256": "b203fe25bb90ad94dc3a4936bf49d08f0c7eca1a2fc6c923d0b9eca59557c67b",
        "fileName": "CLIProxyAPI_8.0.46_windows_amd64.zip"
      },
      "arm64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.46/CLIProxyAPI_8.0.46_windows_aarch64.zip",
        "sha256": "83ede8ad3f97d9c8c09aa8097c432c9e377f7f5566f7ffbc10a9d9f74e07504c",
        "fileName": "CLIProxyAPI_8.0.46_windows_aarch64.zip"
      }
    },
    "linux": {
      "x64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.46/CLIProxyAPI_8.0.46_linux_amd64.tar.gz",
        "sha256": "471f5235c501c19d3dec85c06e7612f0fe5ce3f823ef75331c2097aad8ed3c62",
        "fileName": "CLIProxyAPI_8.0.46_linux_amd64.tar.gz"
      },
      "arm64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.46/CLIProxyAPI_8.0.46_linux_aarch64.tar.gz",
        "sha256": "07b792e0d2eedb46fcb6c9d1eda913b4c53413076a03199346a85a573fd00de7",
        "fileName": "CLIProxyAPI_8.0.46_linux_aarch64.tar.gz"
      }
    },
    "darwin": {
      "x64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.46/CLIProxyAPI_8.0.46_darwin_amd64.tar.gz",
        "sha256": "bf8ba3bd1990e115bfba6f61a93d83233974a5457540ebdd03df69d142f14efb",
        "fileName": "CLIProxyAPI_8.0.46_darwin_amd64.tar.gz"
      },
      "arm64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.46/CLIProxyAPI_8.0.46_darwin_aarch64.tar.gz",
        "sha256": "f9cdb85ccd70602ce084ad0aa8576a057a5e7dd8ff63a64b229cd145c5e6652b",
        "fileName": "CLIProxyAPI_8.0.46_darwin_aarch64.tar.gz"
      }
    }
  },
  "install": {
    "steps": [
      {
        "id": "copy-bundled-release",
        "kind": "download"
      },
      {
        "id": "verify-sha256",
        "kind": "verify"
      },
      {
        "id": "prepare-cpa",
        "kind": "command",
        "executable": "{runtime}",
        "arguments": [
          "{adapterRoot}/cpa-managed.cjs",
          "prepare",
          "{home}",
          "{state}",
          "{artifact}"
        ],
        "timeoutMs": 300000
      },
      {
        "id": "assert-cpa-runtime",
        "kind": "assert-file",
        "path": "runtime/CPA_RUNTIME.json"
      },
      {
        "id": "activate",
        "kind": "activate"
      }
    ]
  },
  "launch": {
    "primaryProcessId": "cpa",
    "processes": [
      {
        "id": "cpa",
        "mode": "foreground",
        "executable": "{runtime}",
        "arguments": [
          "{adapterRoot}/cpa-managed.cjs",
          "run",
          "{home}",
          "{state}"
        ],
        "environment": {
          "CODING_TOOLS_CPA_MANAGEMENT_KEY": "{secret:managementKey}",
          "CODING_TOOLS_CPA_PROXY_API_KEY": "{secret:proxyApiKey}"
        }
      }
    ],
    "adopt": [
      {
        "id": "refresh-cpa-config",
        "executable": "{runtime}",
        "arguments": [
          "{adapterRoot}/cpa-managed.cjs",
          "refresh",
          "{state}"
        ],
        "environment": {
          "CODING_TOOLS_CPA_MANAGEMENT_KEY": "{secret:managementKey}",
          "CODING_TOOLS_CPA_PROXY_API_KEY": "{secret:proxyApiKey}"
        },
        "timeoutMs": 30000
      }
    ],
    "stop": []
  },
  "health": {
    "endpoint": "http://127.0.0.1:8317/v1/models",
    "authorization": "Bearer {secret:proxyApiKey}",
    "acceptStatus": [
      200
    ]
  }
}
