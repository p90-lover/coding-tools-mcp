{
  "schemaVersion": 1,
  "id": "cpa",
  "name": "CPA / CLIProxyAPI",
  "managedBy": "Coding Tools",
  "loopbackOnly": true,
  "repository": "router-for-me/CLIProxyAPI",
  "repositoryUrl": "https://github.com/router-for-me/CLIProxyAPI",
  "version": "8.0.2",
  "strategy": "release-binary",
  "bundle": { "required": true },
  "license": "MIT",
  "licenseFile": "LICENSE",
  "credentials": {
    "managementKey": {
      "required": false,
      "generated": true,
      "minimumLength": 32,
      "purpose": "Local CLIProxyAPI management API"
    },
    "proxyApiKey": {
      "required": false,
      "generated": true,
      "minimumLength": 32,
      "purpose": "Local OpenAI-compatible proxy API"
    }
  },
  "platforms": {
    "win32": {
      "x64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.2/CLIProxyAPI_8.0.2_windows_amd64.zip",
        "sha256": "75118e47d27d5446620a9e6b558ee54fa8377858c8c9b4cab7ba44b313aa10f2",
        "fileName": "CLIProxyAPI_8.0.2_windows_amd64.zip"
      },
      "arm64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.2/CLIProxyAPI_8.0.2_windows_aarch64.zip",
        "sha256": "28818ee9a504a89a2b239e0f0a714d2d395538492a9c64fd5a010db1e960df6b",
        "fileName": "CLIProxyAPI_8.0.2_windows_aarch64.zip"
      }
    },
    "linux": {
      "x64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.2/CLIProxyAPI_8.0.2_linux_amd64.tar.gz",
        "sha256": "7478ab50f5b59cb34911547b2b527275bd0bf64f52687588dcce65a386f244ad",
        "fileName": "CLIProxyAPI_8.0.2_linux_amd64.tar.gz"
      },
      "arm64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.2/CLIProxyAPI_8.0.2_linux_aarch64.tar.gz",
        "sha256": "e790af5d63b6bd803c4173ef0d7dc8aaf8e5d66f822d28551c45fd5112918065",
        "fileName": "CLIProxyAPI_8.0.2_linux_aarch64.tar.gz"
      }
    },
    "darwin": {
      "x64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.2/CLIProxyAPI_8.0.2_darwin_amd64.tar.gz",
        "sha256": "7f5d192bd92fd06d24c5e286b673e3fbd0b05fee69983729cdb20792b5a857a1",
        "fileName": "CLIProxyAPI_8.0.2_darwin_amd64.tar.gz"
      },
      "arm64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.2/CLIProxyAPI_8.0.2_darwin_aarch64.tar.gz",
        "sha256": "305424f9a67e12b1e0e37f772c0f960f946f0e3c385226ab481a12e50f0621ae",
        "fileName": "CLIProxyAPI_8.0.2_darwin_aarch64.tar.gz"
      }
    }
  },
  "install": {
    "steps": [
      {
        "id": "copy-bundled-release",
        "kind": "download"
      },
      {
        "id": "verify-sha256",
        "kind": "verify"
      },
      {
        "id": "prepare-cpa",
        "kind": "command",
        "executable": "{runtime}",
        "arguments": [
          "{adapterRoot}/cpa-managed.cjs",
          "prepare",
          "{home}",
          "{state}",
          "{artifact}"
        ],
        "timeoutMs": 300000
      },
      {
        "id": "assert-cpa-runtime",
        "kind": "assert-file",
        "path": "runtime/CPA_RUNTIME.json"
      },
      {
        "id": "activate",
        "kind": "activate"
      }
    ]
  },
  "launch": {
    "primaryProcessId": "cpa",
    "processes": [
      {
        "id": "cpa",
        "mode": "foreground",
        "executable": "{runtime}",
        "arguments": [
          "{adapterRoot}/cpa-managed.cjs",
          "run",
          "{home}",
          "{state}"
        ],
        "environment": {
          "CODING_TOOLS_CPA_MANAGEMENT_KEY": "{secret:managementKey}",
          "CODING_TOOLS_CPA_PROXY_API_KEY": "{secret:proxyApiKey}"
        }
      }
    ],
    "stop": []
  },
  "health": {
    "endpoint": "http://127.0.0.1:8317/v1/models",
    "authorization": "Bearer {secret:proxyApiKey}",
    "acceptStatus": [
      200
    ]
  }
}
