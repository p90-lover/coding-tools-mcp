{
  "schemaVersion": 1,
  "id": "cpa",
  "name": "CPA / CLIProxyAPI",
  "managedBy": "Coding Tools",
  "loopbackOnly": true,
  "repository": "router-for-me/CLIProxyAPI",
  "repositoryUrl": "https://github.com/router-for-me/CLIProxyAPI",
  "version": "8.0.32",
  "strategy": "release-binary",
  "bundle": { "required": true },
  "license": "MIT",
  "licenseFile": "LICENSE",
  "credentials": {
    "managementKey": {
      "required": false,
      "generated": true,
      "minimumLength": 32,
      "purpose": "Local CLIProxyAPI management API"
    },
    "proxyApiKey": {
      "required": false,
      "generated": true,
      "minimumLength": 32,
      "purpose": "Local OpenAI-compatible proxy API"
    }
  },
  "platforms": {
    "win32": {
      "x64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.32/CLIProxyAPI_8.0.32_windows_amd64.zip",
        "sha256": "df364b1f2dc9fe357f6a481bfb8a4066c3e5f5ef4ad7abfe45e59b4cec547c18",
        "fileName": "CLIProxyAPI_8.0.32_windows_amd64.zip"
      },
      "arm64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.32/CLIProxyAPI_8.0.32_windows_aarch64.zip",
        "sha256": "9e83b3f19f3359b52a1fe7acc763ed9285698a46d49caec650943d5b67e82010",
        "fileName": "CLIProxyAPI_8.0.32_windows_aarch64.zip"
      }
    },
    "linux": {
      "x64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.32/CLIProxyAPI_8.0.32_linux_amd64.tar.gz",
        "sha256": "082a4a38d9470c070ac85ab2d9c4a2aa51f9a7ee19831c3b811e26fe5b7480a7",
        "fileName": "CLIProxyAPI_8.0.32_linux_amd64.tar.gz"
      },
      "arm64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.32/CLIProxyAPI_8.0.32_linux_aarch64.tar.gz",
        "sha256": "76aac452dd224490ea5ea1ea0224199d7a410f14ef39a087b81893d15c62f363",
        "fileName": "CLIProxyAPI_8.0.32_linux_aarch64.tar.gz"
      }
    },
    "darwin": {
      "x64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.32/CLIProxyAPI_8.0.32_darwin_amd64.tar.gz",
        "sha256": "c327f421d995692f6590a752abd449db5e71df61803b7041e4d3bd59cd1e1bd8",
        "fileName": "CLIProxyAPI_8.0.32_darwin_amd64.tar.gz"
      },
      "arm64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.32/CLIProxyAPI_8.0.32_darwin_aarch64.tar.gz",
        "sha256": "48fe6a391a01e730ee6ebe3f1609ff92578a97a7a9a44579013ca8f3a6d58d51",
        "fileName": "CLIProxyAPI_8.0.32_darwin_aarch64.tar.gz"
      }
    }
  },
  "install": {
    "steps": [
      {
        "id": "copy-bundled-release",
        "kind": "download"
      },
      {
        "id": "verify-sha256",
        "kind": "verify"
      },
      {
        "id": "prepare-cpa",
        "kind": "command",
        "executable": "{runtime}",
        "arguments": [
          "{adapterRoot}/cpa-managed.cjs",
          "prepare",
          "{home}",
          "{state}",
          "{artifact}"
        ],
        "timeoutMs": 300000
      },
      {
        "id": "assert-cpa-runtime",
        "kind": "assert-file",
        "path": "runtime/CPA_RUNTIME.json"
      },
      {
        "id": "activate",
        "kind": "activate"
      }
    ]
  },
  "launch": {
    "primaryProcessId": "cpa",
    "processes": [
      {
        "id": "cpa",
        "mode": "foreground",
        "executable": "{runtime}",
        "arguments": [
          "{adapterRoot}/cpa-managed.cjs",
          "run",
          "{home}",
          "{state}"
        ],
        "environment": {
          "CODING_TOOLS_CPA_MANAGEMENT_KEY": "{secret:managementKey}",
          "CODING_TOOLS_CPA_PROXY_API_KEY": "{secret:proxyApiKey}"
        }
      }
    ],
    "stop": []
  },
  "health": {
    "endpoint": "http://127.0.0.1:8317/v1/models",
    "authorization": "Bearer {secret:proxyApiKey}",
    "acceptStatus": [
      200
    ]
  }
}
