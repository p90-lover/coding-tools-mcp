{
  "schemaVersion": 1,
  "id": "cpa",
  "name": "CPA / CLIProxyAPI",
  "managedBy": "Coding Tools",
  "loopbackOnly": true,
  "repository": "router-for-me/CLIProxyAPI",
  "repositoryUrl": "https://github.com/router-for-me/CLIProxyAPI",
  "version": "8.0.63",
  "strategy": "release-binary",
  "bundle": { "required": true },
  "updates": { "source": "github-release", "checksums": "checksums.txt" },
  "license": "MIT",
  "licenseFile": "LICENSE",
  "credentials": {
    "managementKey": {
      "required": false,
      "generated": true,
      "minimumLength": 32,
      "purpose": "Local CLIProxyAPI management API"
    },
    "proxyApiKey": {
      "required": false,
      "generated": true,
      "minimumLength": 32,
      "purpose": "Local OpenAI-compatible proxy API"
    }
  },
  "platforms": {
    "win32": {
      "x64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.63/CLIProxyAPI_8.0.63_windows_amd64.zip",
        "sha256": "5d8c7a093580c25cace076344dd650c9318ecb9990d9e2147bcee0c515a24b2a",
        "fileName": "CLIProxyAPI_8.0.63_windows_amd64.zip"
      },
      "arm64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.63/CLIProxyAPI_8.0.63_windows_aarch64.zip",
        "sha256": "074f6e2372f40e25b8a36a5629a108ad94f33d2c7474bf90d47c666a1dc56f48",
        "fileName": "CLIProxyAPI_8.0.63_windows_aarch64.zip"
      }
    },
    "linux": {
      "x64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.63/CLIProxyAPI_8.0.63_linux_amd64.tar.gz",
        "sha256": "bce20e7eb3f985f9f03b72be21d99f0427c25247248d4e614493ed57ce71e9e5",
        "fileName": "CLIProxyAPI_8.0.63_linux_amd64.tar.gz"
      },
      "arm64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.63/CLIProxyAPI_8.0.63_linux_aarch64.tar.gz",
        "sha256": "f32091a2281be9170861ec81bb70f3541b5c1c8659f10baa70d015e1c1a93aed",
        "fileName": "CLIProxyAPI_8.0.63_linux_aarch64.tar.gz"
      }
    },
    "darwin": {
      "x64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.63/CLIProxyAPI_8.0.63_darwin_amd64.tar.gz",
        "sha256": "1dd6eb617e3be3a34b3395c8fa6b57e71ea298c7816eadd4e6ce0f025d1234d5",
        "fileName": "CLIProxyAPI_8.0.63_darwin_amd64.tar.gz"
      },
      "arm64": {
        "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.63/CLIProxyAPI_8.0.63_darwin_aarch64.tar.gz",
        "sha256": "1336299530082d655fbdfdae866836d070aeec9379a77ef1c5cc25c432b6653a",
        "fileName": "CLIProxyAPI_8.0.63_darwin_aarch64.tar.gz"
      }
    }
  },
  "install": {
    "steps": [
      {
        "id": "copy-bundled-release",
        "kind": "download"
      },
      {
        "id": "verify-sha256",
        "kind": "verify"
      },
      {
        "id": "prepare-cpa",
        "kind": "command",
        "executable": "{runtime}",
        "arguments": [
          "{adapterRoot}/cpa-managed.cjs",
          "prepare",
          "{home}",
          "{state}",
          "{artifact}"
        ],
        "timeoutMs": 300000
      },
      {
        "id": "assert-cpa-runtime",
        "kind": "assert-file",
        "path": "runtime/CPA_RUNTIME.json"
      },
      {
        "id": "activate",
        "kind": "activate"
      }
    ]
  },
  "launch": {
    "primaryProcessId": "cpa",
    "processes": [
      {
        "id": "cpa",
        "mode": "foreground",
        "executable": "{runtime}",
        "arguments": [
          "{adapterRoot}/cpa-managed.cjs",
          "run",
          "{home}",
          "{state}"
        ],
        "environment": {
          "CODING_TOOLS_CPA_MANAGEMENT_KEY": "{secret:managementKey}",
          "CODING_TOOLS_CPA_PROXY_API_KEY": "{secret:proxyApiKey}"
        }
      }
    ],
    "adopt": [
      {
        "id": "refresh-cpa-config",
        "executable": "{runtime}",
        "arguments": [
          "{adapterRoot}/cpa-managed.cjs",
          "refresh",
          "{state}"
        ],
        "environment": {
          "CODING_TOOLS_CPA_MANAGEMENT_KEY": "{secret:managementKey}",
          "CODING_TOOLS_CPA_PROXY_API_KEY": "{secret:proxyApiKey}"
        },
        "timeoutMs": 30000
      }
    ],
    "stop": []
  },
  "health": {
    "endpoint": "http://127.0.0.1:8317/v1/models",
    "authorization": "Bearer {secret:proxyApiKey}",
    "acceptStatus": [
      200
    ]
  }
}
