{
  "schemaVersion": 1,
  "id": "paseo",
  "name": "Paseo",
  "managedBy": "Coding Tools",
  "loopbackOnly": true,
  "repository": "getpaseo/paseo",
  "repositoryUrl": "https://github.com/getpaseo/paseo.git",
  "commit": "1e4ba65c6d75a6b061a1d54141f2f105b5908a96",
  "version": "0.8.0",
  "patchRevision": "codex-cpa-host-env-v1",
  "strategy": "bundled-source",
  "license": "Apache-2.0",
  "bundle": {
    "required": true,
    "entrypoint": "package.json",
    "prebuilt": false
  },
  "install": {
    "steps": [
      { "id": "unpack-bundled-source", "kind": "unpack-bundle" },
      { "id": "npm-ci", "kind": "command", "executable": "{npm}", "arguments": ["ci"], "skipIfFile": "node_modules", "skipIfExists": "node_modules" },
      { "id": "build-server", "kind": "command", "executable": "{npm}", "arguments": ["run", "build:server"], "skipIfFile": "dist" },
      { "id": "activate", "kind": "activate" }
    ]
  },
  "launch": {
    "processes": [
      {
        "id": "daemon",
        "mode": "foreground",
        "executable": "{npm}",
        "arguments": ["start"],
        "environment": {
          "PASEO_LISTEN": "127.0.0.1:6768",
          "PASEO_HOME": "{state}",
          "PASEO_WEB_UI_ENABLED": "true",
          "PASEO_WEB_UI_DIST_DIR": "{home}/packages/server/dist/server/web-ui"
        }
      }
    ]
  },
  "health": {
    "endpoint": "http://127.0.0.1:6768/",
    "acceptStatus": [200]
  },
  "executionEndpoint": "ws://127.0.0.1:6768/ws"
}
