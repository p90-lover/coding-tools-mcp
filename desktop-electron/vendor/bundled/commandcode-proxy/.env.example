# =============================================================================
# CommandCode AI Proxy — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# A secret key that clients must send in the Authorization header to use this
# proxy. Choose any long random string (e.g. `openssl rand -hex 32`).
PROXY_API_KEY=

# Your CommandCode API key. Obtain one by running `commandcode` CLI and
# completing the auth flow. The key is stored in ~/.commandcode/auth.json.
# If omitted, the proxy reads ~/.commandcode/auth.json automatically.
# CC_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — Server
# ---------------------------------------------------------------------------

# Port and host the HTTP server binds to.
# PROXY_PORT=8787
# PROXY_HOST=0.0.0.0

# Public URL printed in the startup banner (for copy-pasting into client
# configs). Defaults to http://localhost:$PROXY_PORT.
# PROXY_PUBLIC_URL=https://my-proxy.example.com

# ---------------------------------------------------------------------------
# OPTIONAL — Model routing
# ---------------------------------------------------------------------------

# Default model all requests are routed to.
# PROXY_DEFAULT_MODEL=deepseek/deepseek-v4-pro

# Vision model used to describe images before passing to the coding model.
# PROXY_VISION_MODEL=moonshotai/Kimi-K2.6

# Coding model used for all non-vision tasks.
# PROXY_CODING_MODEL=deepseek/deepseek-v4-pro

# ---------------------------------------------------------------------------
# OPTIONAL — CommandCode backend
# ---------------------------------------------------------------------------

# CommandCode API base URL (rarely needs changing).
# CC_API_BASE=https://api.commandcode.ai

# CommandCode CLI version sent in request headers.
# CC_CLI_VERSION=0.26.3

# Working directory sent in the config payload.
# CC_WORKING_DIR=/home/user/project
