{
  "id": "anneal",
  "name": "Anneal",
  "repository": "mosonlab/anneal",
  "commit": "e43b72b10ad389f090a0be18eea5d2bcef468f5e",
  "version": "0.9.0",
  "license": "MIT",
  "licenseFile": "LICENSE",
  "defaultEndpoint": "http://127.0.0.1:3000/",
  "environmentEndpoint": "CODING_TOOLS_ANNEAL_URL",
  "environmentHome": "CODING_TOOLS_ANNEAL_HOME",
  "sections": [
    "tasks",
    "projects",
    "agents",
    "sessions",
    "inbox",
    "automations",
    "triggers",
    "costs",
    "goals",
    "connections",
    "settings"
  ],
  "sectionPaths": {
    "tasks": "/tasks",
    "projects": "/projects",
    "agents": "/agents",
    "sessions": "/sessions",
    "inbox": "/inbox",
    "automations": "/automations",
    "triggers": "/triggers",
    "costs": "/costs",
    "goals": "/goals",
    "connections": "/connections",
    "settings": "/settings"
  },
  "runtime": {
    "managed": true,
    "platforms": ["darwin", "linux"],
    "prerequisites": [
      "Git",
      "Node.js 22.13 or newer",
      "npm 10.9.2 or newer",
      "Docker Compose",
      "Official Codex CLI"
    ],
    "provisionCommands": [
      { "executable": "npm", "arguments": ["ci"] },
      { "executable": "npm", "arguments": ["run", "setup:local"] },
      { "executable": "npm", "arguments": ["run", "build"] },
      {
        "executable": "docker",
        "arguments": ["compose", "up", "-d", "--wait", "--wait-timeout", "60", "postgres"]
      },
      {
        "executable": "npm",
        "arguments": ["run", "db:migrate:release", "--", "--fresh"]
      }
    ]
  },
  "launch": {
    "processes": [
      { "executable": "npm", "arguments": ["run", "dev:api"] },
      { "executable": "npm", "arguments": ["run", "dev:web"] },
      { "executable": "npm", "arguments": ["run", "dev:runner"] },
      { "executable": "npm", "arguments": ["run", "dev:inbox"] }
    ],
    "workingDirectoryEnvironment": "CODING_TOOLS_ANNEAL_HOME"
  }
}
