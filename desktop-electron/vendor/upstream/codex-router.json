{
  "id": "codex-router",
  "name": "Codex Router",
  "mode": "external-local-service",
  "defaultEndpoint": "http://127.0.0.1:4202/",
  "environmentEndpoint": "CODING_TOOLS_CODEX_ROUTER_URL",
